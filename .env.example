# Copy to .env (git-ignored) and fill in. Never commit real values (NFR-SE-2).
# Then: chmod 600 .env
#
# Where Cerebra looks (first found wins; real environment variables always win):
#   $CEREBRA_ENV_FILE, else ~/.config/cerebra/.env, else ./.env
# Use ~/.config/cerebra/.env for the MCP server (an AI client starts it from another folder).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: public-only lookups with an API key
CEREBRA_YOUTUBE_API_KEY=

# Live API tests and headless runs only (see docs/testing/live-smoke-runbook.md)
CEREBRA_REFRESH_TOKEN=
CEREBRA_REFRESH_TOKEN_SCOPES=
